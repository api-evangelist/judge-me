  "info": {
    "_postman_id": "11d08792-9d65-40f1-9ed9-cce390c2e205",
    "name": "Judge.me Products Widgets API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Judge.me product reviews platform for Shopify and other e-commerce storefronts. Endpoints let you list and create reviews, resolve products, send review request emails, and fetch ready-to-render review widget HTML. Requests are authenticated with a shop_domain and an api_token query parameter. A public api_token may be used for GET widget calls in public JavaScript environments; a private api_token grants read/write access and must be used server-side only.\n\nContact Support:\n Name: Judge.me Support\n Email: support@judge.me",
      "type": "text/plain"
    }
  }
